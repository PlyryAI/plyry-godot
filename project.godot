config_version=5

[application]

config/name="Plyry Godot API Example"
run/main_scene="res://examples/basic/main.tscn"

[editor_plugins]

enabled=PackedStringArray("res://addons/plyry/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
